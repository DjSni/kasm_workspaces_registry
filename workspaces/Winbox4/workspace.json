{
  "description": "Winbox4 is a small utility that allows administration of MikroTik RouterOS using a fast and simple GUI.",
  "docker_registry": "https://index.docker.io/v1/",
  "image_src": "winbox4.png",
  "run_config": {
    "hostname": "winbox4"
  },
  "exec_config": {
    "go": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --go --url \"$KASM_URL\"'"
    },
    "assign": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --assign --url \"$KASM_URL\"'"
    }
  },
  "categories": [
    "Remote Access"
  ],
  "friendly_name": "Winbox4",
  "architecture": [
    "amd64"
  ],
  "compatibility": [
    {
      "version": "1.16.x",
      "image": "dersni/kasm-images:winbox-1.16.1",
      "uncompressed_size_mb": 1200,
      "available_tags": [
        "latest",
        "winbox-1.16.1"
      ]
    },
    {
      "version": "1.17.x",
      "image": "dersni/kasm-images:winbox-1.17.0",
      "uncompressed_size_mb": 1200,
      "available_tags": [
        "latest",
        "winbox-1.17.0"
      ]
    }
  ]
}