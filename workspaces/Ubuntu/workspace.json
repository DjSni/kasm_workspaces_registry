{
  "description": "A edided Ubuntu Desktop",
  "docker_registry": "https://git.snis.pw/",
  "image_src": "ubuntu.png",
  "run_config": {
    "hostname": "kasm"
  },
  "exec_config": {
    "go": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --go --url \"$KASM_URL\"'"
    },
    "assign": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --assign --url \"$KASM_URL\"'"
    }
  },
  "categories": [
    "Desktop"
  ],
  "friendly_name": "Ubuntu",
  "architecture": [
    "amd64"
  ],
  "compatibility": [
    {
      "version": "1.16.x",
      "image": "git.snis.pw/docker/kasm-images:ubuntu-desktop-1.16.1",
      "uncompressed_size_mb": 1200,
      "available_tags": [
        "latest",
        "ubuntu-desktop-1.16.1"
      ]
    },
    {
      "version": "1.17.x",
      "image": "git.snis.pw/docker/kasm-images:ubuntu-desktop-latest",
      "uncompressed_size_mb": 1200,
      "available_tags": [
        "latest",
        "ubuntu-desktop-1.17.0"
      ]
    }
  ]
}