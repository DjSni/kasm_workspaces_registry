{
  "description": "Winbox is a small utility that allows administration of MikroTik RouterOS using a fast and simple GUI.",
  "docker_registry": "https://index.docker.io/v1/",
  "image_src": "winbox.png",
  "run_config": {
    "hostname": "kasm"
  },
  "exec_config": {
    "go": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --go --url \"$KASM_URL\"'"
    },
    "assign": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --assign --url \"$KASM_URL\"'"
    }
  },
  "categories": [
    "Remote Access"
  ],
  "friendly_name": "Winbox",
  "architecture": [
    "amd64"
  ],
  "compatibility": [
    {
      "version": "1.16.x",
      "image": "obebete/winbox:latest",
      "uncompressed_size_mb": 1500,
      "available_tags": [
        "latest"
      ]
    },
    {
      "version": "1.17.x",
      "image": "obebete/winbox:latest",
      "uncompressed_size_mb": 1500,
      "available_tags": [
        "latest"
      ]
    },
    {
      "version": "1.18.x",
      "image": "obebete/winbox:latest",
      "uncompressed_size_mb": 1500,
      "available_tags": [
        "latest"
      ]
    }
  ]
}
