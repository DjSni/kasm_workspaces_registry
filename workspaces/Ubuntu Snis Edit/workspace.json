{
  "description": "A edided Ubuntu Desktop",
  "docker_registry": "https://index.docker.io/v1/",
  "image_src": "ubuntu.png",
  "run_config": {
    "hostname": "kasm"
  },
  "exec_config": {
    "go": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --go --url \"$KASM_URL\"'"
    },
    "assign": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --assign --url \"$KASM_URL\"'"
    }
  },
  "categories": [
    "Desktop"
  ],
  "friendly_name": "Snis Ubuntu",
  "architecture": [
    "amd64"
  ],
  "compatibility": [
    {
      "version": [
        "1.16.x",
        "1.17.x"
      ],
      "image": "dersni/docker-kasm-ubuntu-dektop-edit:latest",
      "uncompressed_size_mb": 5000,
      "available_tags": [
        "latest"
      ]
    }
  ]
}